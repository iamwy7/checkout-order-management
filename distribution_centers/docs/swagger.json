{
    "swagger": "2.0",
    "info": {
        "description": "This is a server for managing disctribution centers.",
        "title": "Distribution Centers API",
        "contact": {},
        "version": "1.0"
    },
    "host": "localhost:8080",
    "basePath": "/",
    "paths": {
        "/distributioncenters": {
            "get": {
                "description": "Get all distribution centers of an itemId",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "DistributionCenters"
                ],
                "summary": "List distribution centers",
                "parameters": [
                    {
                        "type": "string",
                        "description": "itemId",
                        "name": "itemId",
                        "in": "query",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/dtos.DistributionCenters"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/api_handler.ErrorResponse"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "api_handler.ErrorResponse": {
            "type": "object",
            "properties": {
                "message": {
                    "type": "string",
                    "example": " message about the error"
                }
            }
        },
        "dtos.DistributionCenter": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "string",
                    "example": "a2d705c1-7431-456b-b65f-bee431694b46"
                },
                "name": {
                    "type": "string",
                    "example": "CD1"
                },
                "quantity": {
                    "type": "integer",
                    "example": 633
                },
                "state": {
                    "type": "string",
                    "example": "SP"
                },
                "status": {
                    "type": "string",
                    "example": "ACTIVE"
                },
                "zone": {
                    "type": "string",
                    "example": "W1"
                }
            }
        },
        "dtos.DistributionCenters": {
            "type": "object",
            "properties": {
                "distributionCenters": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/dtos.DistributionCenter"
                    }
                },
                "itemId": {
                    "type": "string",
                    "example": "493d60ac-64c4-4bc6-8fbf-eefe752790c4"
                }
            }
        }
    }
}